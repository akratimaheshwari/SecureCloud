{
  "name": "secure-cloud-file-storage-backend",
  "version": "1.0.0",
  "description": "Express API for Secure Cloud File Storage with DLP and Intelligent Access Control (rule-based, no AI/ML)",
  "main": "server.js",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node db/seed/seed.js",
    "seed:reset": "node db/seed/seed.js --reset",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  }
}
